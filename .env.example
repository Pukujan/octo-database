# Names only. Keep values blank in Git.
# Runtime configuration for Octo. Copy to `.env` (gitignored) and fill locally.

# --- Canonical PostgreSQL (octo schema) ---
# Migrations, maintenance scripts, and local dev connect as the schema owner here.
DATABASE_URL=

# --- Runtime roles (Slice 14 key-scope isolation fence) ---
# The server runs two roles: `octo_app` (RLS-enforced request path) and
# `octo_service` (BYPASSRLS trusted surface: login/bootstrap, the job worker,
# server-owned jobs/activity writes). Both are created by the Slice 14 migration;
# set their passwords out-of-band (`ALTER ROLE ... PASSWORD ...`) and point these
# here. Leave both unset to fall back to DATABASE_URL (single-connection local dev/CI).
OCTO_DB_URL=
OCTO_SERVICE_URL=

# --- Cloudflare R2 active storage (read by src/storage/r2-client.ts) ---
# The loader accepts either naming; set one pair, not both.
S3_API_ENDPOINT=
ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
# Accepted aliases: R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
OCTO_R2_BUCKET=octo

# --- Server ---
PORT=3001

# Storage backend. Leave unset for R2 (production). Set to `local` only for
# CI/dev so uploads land in /tmp/octo-storage instead of failing closed.
OCTO_STORAGE_BACKEND=

# --- MFA secret envelope (Slice 17) ---
# Key material for the AES-256-GCM envelope that encrypts each principal's TOTP
# secret at rest. Enrolling an authenticator requires it; unset leaves MFA
# enrollment returning MFA_NOT_CONFIGURED while the rest of the app is unaffected.
OCTO_MFA_SECRET=

# --- Session token signing (ISS-1) ---
# HMAC key for the signed, expiring bearer session tokens minted at guest/OAuth
# login. Unset falls back to a per-process random secret, which invalidates every
# session on restart, so self-hosted deployments should set it.
OCTO_SESSION_SECRET=

# --- Google Drive cold archival (Slice 5 / #7) ---
# Server-side OAuth 2.0 refresh token with the minimal `drive.file` scope.
# Unset credentials disable archival; the server reports ARCHIVE_UNAVAILABLE.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional app-controlled archive folder id.
GOOGLE_DRIVE_FOLDER_ID=

# --- Google OAuth sign-in (Slice 1 follow-up; unset disables the button) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Embeddings for retrieval (Slice 8). Any OpenAI-compatible provider. ---
# The InferHub gateway exposes no embeddings endpoint, so this is configured
# separately from INFERHUB_API_KEY. Unset disables document ingest with a clear 503.
OCTO_EMBEDDING_API_KEY=
OCTO_EMBEDDING_BASE_URL=https://api.openai.com/v1
OCTO_EMBEDDING_MODEL=text-embedding-3-small
OCTO_EMBEDDING_DIMENSIONS=1536

# --- InferHub vision QA (CI only; passed via repository secret) ---
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
