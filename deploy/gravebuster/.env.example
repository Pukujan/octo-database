# Octo Production Environment Configuration (Gravebuster)
# Copy to .env on gravebuster (never commit secrets to git).

# Base Public URL
PUBLIC_BASE_URL=https://octodb.design-bakery.com

# PostgreSQL Database (points to internal octo-db service container)
POSTGRES_PASSWORD=generate_a_secure_password_here
DATABASE_URL=postgresql://postgres:generate_a_secure_password_here@octo-db:5432/postgres

# Google OAuth Credentials
# Note: Reuses existing Google OAuth Client ID / Secret from Google Cloud Console.
# Ensure https://octodb.design-bakery.com/api/auth/google/callback is registered as authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# Media Security Key (used to cryptographically sign thumbnail and share URLs)
OCTO_MEDIA_SECRET=generate_a_random_32_byte_hex_secret_here

# Storage Backend (R2 is production default)
OCTO_STORAGE_BACKEND=r2
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=octo
CLOUDFLARE_R2_REGION=auto

# Google Drive (Cold Archival Tier)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token
