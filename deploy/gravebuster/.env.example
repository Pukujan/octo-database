# Octo Production Environment Configuration (Gravebuster)
# Copy to .env on gravebuster (never commit secrets to git).

# Base Public URL
PUBLIC_BASE_URL=https://octodb.design-bakery.com
# Local web port exposed on gravebuster (8091 is default since 8090 is taken by groktocrawl)
WEB_HOST_PORT=8091

# PostgreSQL Database (points to internal octo-db service container)
POSTGRES_PASSWORD=generate_a_secure_password_here
# Schema-owner connection: used by migrations and one-time maintenance only.
DATABASE_URL=postgresql://postgres:generate_a_secure_password_here@octo-db:5432/postgres

# Runtime roles (Slice 14 key-scope isolation fence). Apply the Slice 14 migration
# to the live database first, then set each role's password out-of-band and point
# the two runtime connections here. `octo_app` is RLS-enforced (the request path);
# `octo_service` is BYPASSRLS (the small trusted surface). Until these are set the
# server falls back to DATABASE_URL and RLS stays dormant.
OCTO_DB_URL=postgresql://octo_app:generate_a_secure_password_here@octo-db:5432/postgres
OCTO_SERVICE_URL=postgresql://octo_service:generate_a_secure_password_here@octo-db:5432/postgres

# Privileged connection for provisioning per-workspace databases (Slice 13). It
# needs CREATE DATABASE / CREATE ROLE, which octo_app and octo_service deliberately
# lack. Set the password out-of-band and never commit it. Unset leaves
# POST /api/workspaces/{id}/database failing with PROVISIONING_NOT_CONFIGURED.
OCTO_ADMIN_URL=postgresql://postgres:generate_a_secure_password_here@octo-db:5432/postgres

# Google OAuth Credentials
# Note: Reuses existing Google OAuth Client ID / Secret from Google Cloud Console.
# Ensure https://octodb.design-bakery.com/api/auth/google/callback is registered as authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# Media Security Key (used to cryptographically sign thumbnail and share URLs)
OCTO_MEDIA_SECRET=generate_a_random_32_byte_hex_secret_here

# Session token signing key (ISS-1). Signs the bearer session tokens minted at
# guest/OAuth login. Unset falls back to a per-process secret that invalidates all
# sessions on restart, so set it in any long-running deployment.
OCTO_SESSION_SECRET=generate_a_random_32_byte_hex_secret_here

# Session lifetime in seconds. Defaults to 1200 (20 minutes) when unset. Raise it to
# keep sessions alive longer; the client also locks after 20 minutes idle.
OCTO_SESSION_TTL_SECONDS=

# Storage Backend (R2 is production default)
OCTO_STORAGE_BACKEND=r2
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=octo
CLOUDFLARE_R2_REGION=auto

# Google Drive (Cold Archival Tier)
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token

# Embeddings for retrieval (Slice 8). Any [OI]-compatible provider.
# Unset leaves POST /api/rag/documents and POST /api/rag/query returning 503
# EMBEDDING_PROVIDER_NOT_CONFIGURED -- the one query-shaped surface the server
# exposes. The InferHub gateway has no embeddings route, so this needs its own
# key. Dimensions must match the vector width in the Slice 8 migration (1536).
OCTO_EMBEDDING_API_KEY=your-embeddings-provider-api-key
OCTO_EMBEDDING_BASE_URL=https://api.openai.com/v1
OCTO_EMBEDDING_MODEL=text-embedding-3-small
OCTO_EMBEDDING_DIMENSIONS=1536
